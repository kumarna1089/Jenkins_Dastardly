pipeline {
    agent any
    stages {
	stage ("Clean Up") {
            steps {     
                dat 'docker stop owasp'
                dat 'docker rm owasp'
            } 
        }
        stage ("ZAP container image Pull") {
            steps {
                dat 'docker pull ghcr.io/zaproxy/zaproxy:stable'
		dat 'docker run -dt --name owasp ghcr.io/zaproxy/zaproxy:stable /bin/bash'
            }
        }
		stage('Prepare wrk directory') {
             steps {
                         dat """
                             docker exec owasp \
                             mkdir /zap/wrk
                         """
                 }
         }
        stage ("ZAP Scan") {
            steps {     
                dat '''
			docker exec owasp \
                     zap-full-scan.py \
                     -t https://ginandjuice.shop \
					 -x ZAPreport.xml \
                     -I
                 '''
            } 
        }
		stage('Copy Report to Workspace'){
             steps {
                 script {
                     dat '''
                         docker cp owasp:/zap/wrk/ZAPreport.xml ${WORKSPACE}/ZAPreport.xml
                     '''
                 }
             }
         }
    }
}
